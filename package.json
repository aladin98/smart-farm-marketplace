{
  "name": "Smart_Farm_and_Marketplace",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/cds-dk": "^10",
    "@cap-js/sqlite": "^3",
    "cors": "^2.8.6"
  },
  "devDependencies": {
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds deploy --to sqlite:db.sqlite && cds serve",
    "watch-products-ui": "cds watch --open smartfarm.marketplace.productsui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      },
      "auth": {
        "kind": "mocked"
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/products-ui"
  ]
}